#!/usr/bin/env bash

set -e

REGION="eu-central-1"
KINESIS_STACK="SDL-Firehose"
COGNITO_STACK="Kinesis-Data-Generator-Cognito-User"
KDG_USERNAME="aws-datalake"
KDG_PASSWORD="password12"
echo "====Deploy all stacks via CloudFormation===="

echo ""
echo "---- [1/2] Deploying Kinesis Firehose stream stack: $KINESIS_STACK ----"
aws cloudformation deploy \
  --template-file 01-kinesis.yaml \
  --stack-name SDL-Firehose \
  --region eu-central-1

echo ""
echo "---- [2/2] Deploying Cognito / KDG stack: $COGNITO_STACK ----"
aws cloudformation deploy \
  --template-file 02-cognito-setup.yaml \
  --stack-name $COGNITO_STACK \
  --region $REGION \
  --capabilities CAPABILITY_NAMED_IAM \
  --parameter-overrides \
    Username=$KDG_USERNAME \
    Password=$KDG_PASSWORD

echo ""
echo "---- Setting permanent password for Cognito user ----"
USER_POOL_ID=$(aws cloudformation describe-stacks \
  --stack-name $COGNITO_STACK \
  --region $REGION \
  --query "Stacks[0].Outputs[?OutputKey=='UserPoolId'].OutputValue" \
  --output text)

aws cognito-idp admin-set-user-password \
  --user-pool-id $USER_POOL_ID \
  --username $KDG_USERNAME \
  --password $KDG_PASSWORD \
  --permanent \
  --region $REGION

echo ""
echo "====All stacks deployed successfully===="

echo ""
echo "---- Kinesis Data Generator URL ----"
aws cloudformation describe-stacks \
  --stack-name $COGNITO_STACK \
  --region $REGION \
  --query "Stacks[0].Outputs[?OutputKey=='KinesisDataGeneratorUrl'].OutputValue" \
  --output text
