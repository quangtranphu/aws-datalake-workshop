{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "WorkshopReadOnlyDiscovery",
			"Effect": "Allow",
			"Action": [
				"cloudformation:DescribeStacks",
				"cloudformation:DescribeStackEvents",
				"cloudformation:DescribeStackResources",
				"cloudformation:GetTemplate",
				"cloudformation:GetTemplateSummary",
				"cloudformation:ListStacks",
				"cloudformation:ValidateTemplate",
				"cloudwatch:GetMetricData",
				"cloudwatch:GetMetricStatistics",
				"cloudwatch:ListMetrics",
				"firehose:ListDeliveryStreams",
				"glue:CreateScript",
				"glue:GetDatabases",
				"glue:GetConnections",
				"glue:GetJobs",
				"glue:GetCrawlers",
				"glue:ListConnectionTypes",
				"glue:ListCrawlers",
				"glue:ListSessions",
				"glue:UseGlueStudio",
				"iam:GetRole",
				"iam:ListRoles",
				"logs:DescribeLogGroups",
				"logs:DescribeLogStreams",
				"logs:GetLogEvents",
				"logs:FilterLogEvents",
				"s3:GetAccountPublicAccessBlock",
				"s3:ListAllMyBuckets"
			],
			"Resource": "*"
		},
		{
			"Sid": "WorkshopBucketManagement",
			"Effect": "Allow",
			"Action": [
				"s3:GetBucketLocation",
				"s3:GetBucketVersioning",
				"s3:ListBucket",
				"s3:ListBucketVersions",
				"s3:ListBucketMultipartUploads"
			],
			"Resource": [
				"arn:aws:s3:::sdl-immersion-day-*",
				"arn:aws:s3:::aws-glue-assets-*"
			]
		},
		{
			"Sid": "WorkshopBucketObjects",
			"Effect": "Allow",
			"Action": [
				"s3:AbortMultipartUpload",
				"s3:DeleteObject",
				"s3:DeleteObjectVersion",
				"s3:GetObject",
				"s3:GetObjectVersion",
				"s3:PutObject",
				"s3:RestoreObject"
			],
			"Resource": [
				"arn:aws:s3:::sdl-immersion-day-*/*",
				"arn:aws:s3:::aws-glue-assets-*/*"
			]
		},
		{
			"Sid": "CreateRegionalGlueAssetsBucket",
			"Effect": "Allow",
			"Action": "s3:CreateBucket",
			"Resource": "arn:aws:s3:::aws-glue-assets-${aws:PrincipalAccount}-*"
		},
		{
			"Sid": "ReadGdeltOpenData",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:GetObjectVersion",
				"s3:ListBucket",
				"s3:GetBucketLocation"
			],
			"Resource": [
				"arn:aws:s3:::gdelt-open-data",
				"arn:aws:s3:::gdelt-open-data/*"
			]
		},
		{
			"Sid": "ReadKdgLambdaDeploymentPackage",
			"Effect": "Allow",
			"Action": "s3:GetObject",
			"Resource": "arn:aws:s3:::aws-kdg-tools-us-east-1/datagen-cognito-setup.zip"
		},
		{
			"Sid": "ManageWorkshopFirehose",
			"Effect": "Allow",
			"Action": [
				"firehose:CreateDeliveryStream",
				"firehose:DeleteDeliveryStream",
				"firehose:DescribeDeliveryStream",
				"firehose:PutRecord",
				"firehose:PutRecordBatch",
				"firehose:StartDeliveryStreamEncryption",
				"firehose:StopDeliveryStreamEncryption",
				"firehose:TagDeliveryStream",
				"firehose:UntagDeliveryStream",
				"firehose:UpdateDestination"
			],
			"Resource": "arn:aws:firehose:*:*:deliverystream/sdl-firehose-stream"
		},
		{
			"Sid": "CreateWorkshopFirehoseLogGroup",
			"Effect": "Allow",
			"Action": "logs:CreateLogGroup",
			"Resource": "arn:aws:logs:*:*:log-group:/aws/kinesisfirehose/sdl-firehose-stream"
		},
		{
			"Sid": "CreateWorkshopFirehoseLogStreams",
			"Effect": "Allow",
			"Action": "logs:CreateLogStream",
			"Resource": "arn:aws:logs:*:*:log-group:/aws/kinesisfirehose/sdl-firehose-stream:log-stream:*"
		},
		{
			"Sid": "ManageWorkshopGlueCrawlers",
			"Effect": "Allow",
			"Action": [
				"glue:BatchGetCrawlers",
				"glue:DeleteCrawler",
				"glue:GetCrawler",
				"glue:ListCrawls",
				"glue:StartCrawler",
				"glue:StopCrawler",
				"glue:TagResource",
				"glue:UntagResource",
				"glue:UpdateCrawler"
			],
			"Resource": "arn:aws:glue:*:*:crawler/sdl-demo-crawler"
		},
		{
			"Sid": "CreateCrawlerAndReadCrawlerMetrics",
			"Effect": "Allow",
			"Action": [
				"glue:CreateCrawler",
				"glue:GetCrawlerMetrics"
			],
			"Resource": "*"
		},
		{
			"Sid": "ManageWorkshopGlueJobs",
			"Effect": "Allow",
			"Action": [
				"glue:BatchStopJobRun",
				"glue:CreateJob",
				"glue:DeleteJob",
				"glue:GetJob",
				"glue:GetJobRun",
				"glue:GetJobRuns",
				"glue:GetTags",
				"glue:StartJobRun",
				"glue:TagResource",
				"glue:UntagResource",
				"glue:UpdateJob"
			],
			"Resource": [
				"arn:aws:glue:*:*:job/transform-json-to-parquet",
				"arn:aws:glue:*:*:job/Advanced*"
			]
		},
		{
			"Sid": "ManageGlueJobBookmarks",
			"Effect": "Allow",
			"Action": [
				"glue:GetJobBookmark",
				"glue:ResetJobBookmark"
			],
			"Resource": "*"
		},
		{
			"Sid": "ManageGlueInteractiveSessions",
			"Effect": "Allow",
			"Action": [
				"glue:CreateSession",
				"glue:DeleteSession",
				"glue:GetSession",
				"glue:GetStatement",
				"glue:ListStatements",
				"glue:RunStatement",
				"glue:StopSession"
			],
			"Resource": "*"
		},
		{
			"Sid": "ManageWorkshopDataCatalog",
			"Effect": "Allow",
			"Action": [
				"glue:BatchCreatePartition",
				"glue:BatchDeletePartition",
				"glue:BatchGetPartition",
				"glue:CreateDatabase",
				"glue:CreatePartition",
				"glue:CreateTable",
				"glue:DeleteDatabase",
				"glue:DeletePartition",
				"glue:DeleteTable",
				"glue:GetDatabase",
				"glue:GetPartition",
				"glue:GetPartitions",
				"glue:GetTable",
				"glue:GetTables",
				"glue:GetTableVersion",
				"glue:GetTableVersions",
				"glue:SearchTables",
				"glue:UpdateDatabase",
				"glue:UpdatePartition",
				"glue:UpdateTable"
			],
			"Resource": [
				"arn:aws:glue:*:*:catalog",
				"arn:aws:glue:*:*:database/default",
				"arn:aws:glue:*:*:database/sdl-demo-data",
				"arn:aws:glue:*:*:database/gdelt",
				"arn:aws:glue:*:*:table/sdl-demo-data/*",
				"arn:aws:glue:*:*:table/gdelt/*"
			]
		},
		{
			"Sid": "UseAthenaPrimaryWorkgroup",
			"Effect": "Allow",
			"Action": [
				"athena:GetDataCatalog",
				"athena:GetDatabase",
				"athena:GetQueryExecution",
				"athena:GetQueryResults",
				"athena:GetTableMetadata",
				"athena:GetWorkGroup",
				"athena:ListDatabases",
				"athena:ListQueryExecutions",
				"athena:ListTableMetadata",
				"athena:StartQueryExecution",
				"athena:StopQueryExecution"
			],
			"Resource": [
				"arn:aws:athena:*:*:workgroup/primary",
				"arn:aws:athena:*:*:datacatalog/AwsDataCatalog"
			]
		},
		{
			"Sid": "ListAthenaDataCatalogs",
			"Effect": "Allow",
			"Action": "athena:ListDataCatalogs",
			"Resource": "*"
		},
		{
			"Sid": "PassGlueRoleToGlueOnly",
			"Effect": "Allow",
			"Action": "iam:PassRole",
			"Resource": "arn:aws:iam::*:role/SDL-GlueRole",
			"Condition": {
				"StringEquals": {
					"iam:PassedToService": "glue.amazonaws.com"
				}
			}
		},
		{
			"Sid": "PassFirehoseRoleToFirehoseOnly",
			"Effect": "Allow",
			"Action": "iam:PassRole",
			"Resource": "arn:aws:iam::*:role/SDL-FirehoseRole",
			"Condition": {
				"StringEquals": {
					"iam:PassedToService": "firehose.amazonaws.com"
				}
			}
		},
		{
			"Sid": "ManageNamedWorkshopStacks",
			"Effect": "Allow",
			"Action": [
				"cloudformation:CancelUpdateStack",
				"cloudformation:ContinueUpdateRollback",
				"cloudformation:CreateChangeSet",
				"cloudformation:CreateStack",
				"cloudformation:DeleteChangeSet",
				"cloudformation:DeleteStack",
				"cloudformation:DescribeChangeSet",
				"cloudformation:ExecuteChangeSet",
				"cloudformation:SetStackPolicy",
				"cloudformation:UpdateStack"
			],
			"Resource": [
				"arn:aws:cloudformation:*:*:stack/SDL-Service-Roles/*",
				"arn:aws:cloudformation:us-east-1:*:stack/Kinesis-Data-Generator-Cognito-User/*"
			]
		}
	]
}